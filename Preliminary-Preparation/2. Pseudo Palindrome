#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        long long d;
        cin >> n >> d;

        vector<long long> a(n);

        for (int i = 0; i < n; i++)
            cin >> a[i];

        sort(a.begin(), a.end());

        bool possible = true;

        for (int i = 0; i < n / 2; i++) {
            if (a[n - 1 - i] - a[i] > d) {
                possible = false;
                break;
            }
        }

        if (possible)
    cout << "YES\n";
else
    cout << "NO\n";
    }

    return 0;
}

