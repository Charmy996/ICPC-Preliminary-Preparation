#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    long long x;
    cin >> n >> x;

    vector<long long> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i];

    sort(a.begin(), a.end());

    int ans = 1;

    for (int i = 1; i < n; i++) {
        if (a[i - 1] + a[i] <= x)
            ans = i + 1;
        else
            break;
    }

    cout << ans;

    return 0;
}
